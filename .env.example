# Provider keys are entered by the user in the Streamlit UI and are not
# written to this file. Never put a personal provider key in this template.

# Optional external tracing. When enabled, prompts and model output may be
# sent to LangSmith; keep disabled unless you explicitly want external tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-research-assistant

# Inactive workspaces and evaluation status records are removed after this many days.
WORKSPACE_TTL_DAYS=7

# Optional provider-specific pacing for accounts that need it; defaults are 0 seconds.
# GROQ_MIN_INTERVAL_SECONDS=2.5

# Optional provider endpoint overrides. Leave unset to use the official defaults.
# GROQ_BASE_URL=https://api.groq.com   (bare host; the Groq SDK adds /openai/v1 itself.
#                                        The app also accepts the /openai/v1 form and normalizes it.)
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OLLAMA_BASE_URL=http://localhost:11434


# Optional local reranker configuration. The default model downloads on first use.
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANKER_SCOPE_THRESHOLD=0.0
# SCOPE_DISTANCE_THRESHOLD=1.0

# Many-user limits (keep workers at 1-2 on Streamlit Community Cloud, ~2.7 GB RAM)
# EVAL_MAX_WORKERS=2
# EVAL_QUEUE_SLOTS=8

# Limits (raise on a bigger host; defaults suit Streamlit Community Cloud)
# MAX_CHAT_PER_MINUTE=40
# MAX_GOLDEN_QUESTIONS=1000
# MAX_RETRIEVAL_EVAL_QUESTIONS=1000
# MAX_UPLOAD_FILE_COUNT=5
# Questions whose best passage scores below this are refused before calling the LLM.
# Lower it (e.g. -6) to be more permissive; the grounded prompt still declines unsupported answers.
# RERANKER_SCOPE_THRESHOLD=-4.0
# INGEST_MAX_CONCURRENT=2
# MAX_WORKSPACES=300
# MAX_WORKSPACE_INDEX_MB=400
# MAX_CHUNKS_PER_DOCUMENT=20000
# LOCAL_EMBEDDING_ALLOWLIST=
# ALLOW_CUSTOM_LOCAL_MODELS=0
