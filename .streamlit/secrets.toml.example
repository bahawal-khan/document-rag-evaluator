# Copy to .streamlit/secrets.toml locally, or paste into the app's Secrets on
# Streamlit Community Cloud. Never commit the real file.
# Provider API keys (Groq, OpenAI, ...) are NOT configured here: each user
# enters theirs in the sidebar and it stays in their session only.

# WORKSPACE_TTL_DAYS = "7"

# Optional external tracing (sends prompts/outputs to LangSmith):
# LANGCHAIN_TRACING_V2 = "false"
# LANGCHAIN_API_KEY = ""
# LANGCHAIN_PROJECT = "rag-research-assistant"
